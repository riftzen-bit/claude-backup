{
  "enabled": true,
  "gateways": {
    "telegram": {
      "type": "command",
      "command": "curl -s -X POST 'https://api.telegram.org/bot${OPENCLAW_TELEGRAM_TOKEN}/sendMessage' -H 'Content-Type: application/json' -d '{\"chat_id\": \"${OPENCLAW_TELEGRAM_CHAT_ID}\", \"text\": \"{{instruction}}\", \"parse_mode\": \"Markdown\"}'"
    }
  },
  "hooks": {
    "session-start": {
      "enabled": true,
      "gateway": "telegram",
      "instruction": "🟢 *Session Started*\nProject: `{{projectName}}`\nTime: {{timestamp}}"
    },
    "session-end": {
      "enabled": true,
      "gateway": "telegram",
      "instruction": "🔴 *Session Ended*\nProject: `{{projectName}}`\nTime: {{timestamp}}"
    },
    "stop": {
      "enabled": true,
      "gateway": "telegram",
      "instruction": "⏸ *Agent Stopped*\nProject: `{{projectName}}`\nReason: {{reason}}\nTime: {{timestamp}}"
    },
    "notification": {
      "enabled": true,
      "gateway": "telegram",
      "instruction": "🔔 *Notification*\nProject: `{{projectName}}`\n{{contextSummary}}"
    }
  }
}
