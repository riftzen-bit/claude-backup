{
  "env": {
    "MAX_THINKING_TOKENS": "31999",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "75",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_ENABLE_ECC_OBSERVE": "0",
    "CLAUDE_CODE_NEW_INIT": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/paul/.claude/hooks/remind.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/home/paul/.claude/hooks/ecc-observe.sh pre",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/home/paul/.claude/hooks/pre-write-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "/home/paul/.claude/hooks/pre-agent-routing.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/home/paul/.claude/hooks/post-tool.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/home/paul/.claude/hooks/notify.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '<pre-compact-hook>COMPACTION IMMINENT — MANDATORY ACTIONS:\n1. Save feedback/learnings to memory files NOW\n2. Save current task state (done/remaining) to memory\n3. List ALL files you were editing (paths)\n4. After compaction: post-compact.sh will fire — read ALL files it tells you\n5. post-compact.sh will re-inject enforce.md directly before you continue\n6. Owner: Paul, Vietnamese, non-programmer, PST</pre-compact-hook>'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/paul/.claude/hooks/session-start.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "/home/paul/.claude/hooks/post-compact.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/home/paul/.claude/hooks/subagent-stop.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "paplay /usr/share/sounds/freedesktop/stereo/complete.oga 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash -c 'PLUGIN_DIR=$(ls -td /home/paul/.claude/plugins/cache/claude-ultimate-hud/claude-ultimate-hud/*/ 2>/dev/null | head -1); [ -n \"$PLUGIN_DIR\" ] || exit 0; exec \"/home/paul/.bun/bin/bun\" \"${PLUGIN_DIR%/}/dist/index.js\"'"
  },
  "enabledPlugins": {
    "everything-claude-code@everything-claude-code": true,
    "frontend-design@claude-code-plugins": true,
    "learning-output-style@claude-code-plugins": false,
    "claude-ultimate-hud@claude-ultimate-hud": true,
    "superpowers@superpowers-dev": true,
    "security-guidance@claude-code-plugins": true,
    "code-review@claude-code-plugins": true,
    "typescript-lsp@claude-plugins-official": true,
    "vtsls@claude-code-lsps": true,
    "ralph-loop@claude-plugins-official": true,
    "parallel-agents@parallel-agents-local": true
  },
  "extraKnownMarketplaces": {
    "parallel-agents-local": {
      "source": {
        "source": "git",
        "url": "file:///home/paul/parallel-agents"
      }
    },
    "everything-claude-code": {
      "source": {
        "source": "github",
        "repo": "affaan-m/everything-claude-code"
      }
    },
    "claude-code-plugins": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-code.git"
      }
    },
    "claude-ultimate-hud": {
      "source": {
        "source": "github",
        "repo": "hadamyeedady12-dev/claude-ultimate-hud"
      }
    },
    "superpowers-dev": {
      "source": {
        "source": "git",
        "url": "https://github.com/obra/superpowers.git"
      }
    },
    "claude-code-lsps": {
      "source": {
        "source": "github",
        "repo": "Piebald-AI/claude-code-lsps"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "language": "vietnamese",
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Reviewing files",
      "Planning changes",
      "Running checks",
      "Verifying output",
      "Analyzing diff",
      "Inspecting codebase",
      "Checking assumptions",
      "Routing subtasks",
      "Running validators",
      "Preparing answer"
    ]
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "voiceEnabled": false,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true
}
