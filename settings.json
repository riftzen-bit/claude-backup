{
  "env": {
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
    "MAX_THINKING_TOKENS": "31999",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "75",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/paul/.claude/hooks/remind.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/home/paul/.claude/plugins/cache/everything-claude-code/everything-claude-code/1.8.0/skills/continuous-learning-v2/hooks/observe.sh pre",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "/home/paul/.claude/hooks/pre-agent-routing.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/post-tool.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '<pre-compact-hook>COMPACTION IMMINENT — save state NOW:\n1. Save any new feedback/learnings to memory files\n2. Note current task progress (what is done, what remains)\n3. After compaction: re-read ~/.claude/projects/-home-paul/memory/MEMORY.md, ~/.claude/CLAUDE.md, and run git log --oneline -10\n4. Re-read any files you were actively editing\n5. User: Paul, Vietnamese speaker, non-programmer, PST timezone</pre-compact-hook>'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "paplay /usr/share/sounds/freedesktop/stereo/complete.oga 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash -c '\"/home/paul/.bun/bin/bun\" \"$(ls -td ~/.claude/plugins/cache/claude-ultimate-hud/claude-ultimate-hud/*/ 2>/dev/null | head -1 || ls -d ~/.claude/plugins/claude-ultimate-hud/ 2>/dev/null)src/index.ts\"'"
  },
  "enabledPlugins": {
    "everything-claude-code@everything-claude-code": true,
    "frontend-design@claude-code-plugins": true,
    "learning-output-style@claude-code-plugins": true,
    "claude-hud@claude-hud": true,
    "claude-ultimate-hud@claude-ultimate-hud": true,
    "superpowers@superpowers-dev": true,
    "security-guidance@claude-code-plugins": true,
    "hookify@claude-code-plugins": false,
    "plugin-dev@claude-code-plugins": true,
    "code-review@claude-code-plugins": true,
    "ralph-wiggum@claude-code-plugins": true,
    "vtsls@claude-code-lsps": true
  },
  "extraKnownMarketplaces": {
    "everything-claude-code": {
      "source": {
        "source": "github",
        "repo": "affaan-m/everything-claude-code"
      }
    },
    "claude-code-plugins": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-code.git"
      }
    },
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    },
    "claude-ultimate-hud": {
      "source": {
        "source": "github",
        "repo": "hadamyeedady12-dev/claude-ultimate-hud"
      }
    },
    "superpowers-dev": {
      "source": {
        "source": "git",
        "url": "https://github.com/obra/superpowers.git"
      }
    },
    "claude-code-lsps": {
      "source": {
        "source": "github",
        "repo": "Piebald-AI/claude-code-lsps"
      }
    }
  },
  "language": "vietnamese",
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Hallucinating responsibly",
      "Pretending to think",
      "Confidently guessing",
      "Blaming the context window",
      "Consulting my imagination",
      "Speedrunning your tech debt",
      "Overthinking this",
      "Apologizing in advance",
      "Vibing with your codebase",
      "Submitting my best guess"
    ]
  },
  "voiceEnabled": false,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true
}
